NODE_ENV=development
PORT=5000

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_ISSUER=task-evaluation-system
JWT_AUDIENCE=task-evaluation-api

FRONTEND_URL=http://localhost:5173

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=200

# B2 must provide the real Google Sheets-backed user service.
# Keep this false in the integrated application.
DEV_AUTH_MOCK=false
