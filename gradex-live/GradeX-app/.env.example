NODE_ENV=development
# 5000 is taken by AirPlay on macOS
PORT=5050

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_ISSUER=task-evaluation-system
JWT_AUDIENCE=task-evaluation-api

FRONTEND_URL=http://localhost:5173

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000

# "sheets" = Google Sheets + Drive. "local" = demo data in data/local-db.json,
# no Google account needed (development only).
DATA_DRIVER=local

# --- Google (only when DATA_DRIVER=sheets) ---
# Preferred: a service account. Share the spreadsheet and the Drive folder
# (inside a Shared Drive) with the service account's email address.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# ...or paste the key JSON on one line instead of using a file:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Fallback: OAuth refresh token. Publish the OAuth app ("In production"),
# otherwise Google expires the token after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
SHEETS_CACHE_TTL_MS=15000
