{
  "name": "gradex-task-evaluation",
  "version": "1.0.0",
  "private": true,
  "description": "GradeX: task publishing, submissions, scoring and volunteer tracking for Street Cause VNRVJIET",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "demo": "DATA_DRIVER=local DEMO_MODE=true node --watch src/server.js",
    "reset-demo": "node scripts/reset-demo.js",
    "check": "find src test scripts -name \"*.js\" -print0 | xargs -0 -n1 node --check",
    "check-env": "node scripts/check-env.js",
    "check-sheet": "node scripts/check-sheet-headers.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check-drive": "node scripts/check-drive.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "googleapis": "^184.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.1.8"
  }
}
